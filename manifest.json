{
  "manifest_version": 3,
  "name": "Scrap Push",
  "description": "My Todo Appのスクラップにページを保存する拡張機能",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Scraps"
  },
  "options_page": "options.html"
}
